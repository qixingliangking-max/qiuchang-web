{
  "manifest_version": 3,
  "name": "球场档案·竞彩采集器",
  "version": "0.1.3",
  "description": "从中国竞彩网与备用公开竞彩页面读取赛程并同步到球场档案数据库。",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://m.sporttery.cn/*",
    "https://www.sporttery.cn/*",
    "https://webapi.sporttery.cn/*",
    "https://trade.500.com/*",
    "https://live.500.com/*",
    "https://app-live-m.500.com/*",
    "https://open.500.com/*",
    "https://oqtloldkfjxildoribkf.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "球场档案·竞彩采集器",
    "default_popup": "popup.html"
  }
}